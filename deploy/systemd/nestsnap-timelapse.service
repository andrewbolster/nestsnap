[Unit]
Description=nestsnap: build yesterday's timelapse, then mirror it
After=docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/nestsnap/nestsnap.env
Environment=UV_CACHE_DIR=/var/cache/nestsnap/uv
ExecStart=/opt/nestsnap/timelapse.py --timestamp
ExecStartPost=-/bin/systemctl start nestsnap-mirror.service
